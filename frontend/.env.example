# ==========================================
# TaskFlow Frontend - Variables de Entorno
# ==========================================

# URL base del backend (TaskFlow API)
VITE_API_URL=http://localhost:3000

# Clave utilizada para persistir el token JWT en el LocalStorage del navegador
VITE_TOKEN_KEY=taskflow_token

# Nombre de la aplicación mostrado en la interfaz
VITE_APP_NAME=TaskFlow
